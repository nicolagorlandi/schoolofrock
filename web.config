    <staticContent>
            <remove fileExtension=".css" />
            <mimeMap fileExtension=".css" mimeType="text/html" />
      <!-- Add other mime types as necessary -->
    </staticContent>  
    <handlers>
      <add name="PaNet1Sviluppo" path="*" verb="*" modules="FastCgiModule" scriptProcessor="c:\nicola\progetti\pa.net.1\k6venv\scripts\python.exe|c:\nicola\progetti\pa.net.1\k6venv\lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
  </system.webServer>

<appSettings>
    <!-- Required settings -->
    <add key="WSGI_HANDLER" value="PaNet1Project.wsgi.application" />
    <add key="PYTHONPATH" value="c:\nicola\progetti\pa.net.1\k6venv\scripts\" />
   	
    <!-- Optional settings 
    <add key="WSGI_LOG" value="C:\Logs\my_app.log" />
